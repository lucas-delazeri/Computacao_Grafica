{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compilar OpenGL (MSYS2)",
      "command": "C:/msys64/msys2_shell.cmd",
      "args": [
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "g++ -g -std=c++17 -Iinclude src/main.cpp src/glad.c -lglfw3 -lopengl32 -lgdi32 -o zmmr.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}